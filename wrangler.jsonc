{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openaiproxy",
  "main": "src/index.ts",

  // Disable workers.dev deployments. Set to true if you want to deploy to a workers.dev subdomain.
  "workers_dev": false,

  // Compatibility date for Cloudflare runtime behaviour.
  // Learn more: https://developers.cloudflare.com/workers/platform/compatibility-dates/
  "compatibility_date": "2026-10-07",

  "observability": {
    "enabled": true
  },

  // Placement hint: run the Worker in the Cloudflare data center with the
  // lowest latency to AWS us-east-1 (close to OpenAI's API infrastructure).
  // https://developers.cloudflare.com/workers/configuration/placement/
  "placement": {
    "region": "aws:us-east-1"
  }
}
